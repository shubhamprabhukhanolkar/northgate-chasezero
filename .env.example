# Copy this file to .env (in the project root or next to ChaseZero.exe)
# and fill in any one LLM provider API key.

LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

CHASEZERO_HOST=127.0.0.1
CHASEZERO_PORT=8000
